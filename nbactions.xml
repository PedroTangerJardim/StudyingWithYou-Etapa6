<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.executable>java</exec.executable>
            <exec.mainClass>br.com.studyingwithyou.app.Main</exec.mainClass>
            <exec.args>-classpath %classpath br.com.studyingwithyou.app.Main</exec.args>
        </properties>
    </action>
    <action>
        <actionName>test</actionName>
        <goals>
            <goal>test</goal>
        </goals>
    </action>
</actions>
